# BotsBay World — configuration for the harnesses that talk to something over a network.
#
# Copy to `.env`. That file is gitignored and is read only by the Node server: nothing in here
# is ever bundled, served, or put inside a thread, so the API key never reaches the browser.
# A real environment variable beats anything set here.
#
# The local harnesses — Claude Code, Codex, Cursor — need none of this and ignore the file.

# ── n8n ───────────────────────────────────────────────────────────────────────────────
# Your instance, without a trailing slash. Also used to build the deep link that Open follows.
N8N_BASE_URL=https://n8n.botsbay.app

# A personal API key: n8n → Settings → n8n API → Create an API key.
# It needs read access to workflows and executions, and — only if you want the Retry button to
# do anything — permission to retry an execution.
N8N_API_KEY=

# How stale the workflow snapshot is allowed to get, in seconds. The colony polls every 15s and
# is served from that snapshot, so this is what actually decides how often n8n is called.
N8N_POLL_SECONDS=15

# How many pages of 250 to walk. n8n caps a page at 250, and 250 executions can be well under
# an hour on a busy instance — a workflow whose last run fell off the end reads as dormant.
# Raise N8N_EXECUTION_PAGES if workflows look asleep when they are not; each page is one more
# HTTP call per refresh.
N8N_WORKFLOW_PAGES=4
N8N_EXECUTION_PAGES=1
